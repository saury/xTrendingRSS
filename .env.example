# ======================================================
# xTrendingRSS 配置文件
# ======================================================

# ---------------------------
# 必需配置 - X (Twitter) 认证
# ---------------------------
# 从浏览器 Cookies 获取（登录 x.com 后在开发者工具中查看）
# 路径: 开发者工具(F12) → Application → Cookies → https://x.com

TWITTER_AUTH_TOKEN=your_auth_token_here
TWITTER_CT0=your_ct0_token_here

# ---------------------------
# 可选配置 - RSS 生成
# ---------------------------

# 每天抓取的 trending 数量（默认 20）
TRENDING_COUNT=20

# RSS 文件输出路径（默认 trending.xml）
OUTPUT_FILE=trending.xml

# RSS Feed 自引用 URL（替换为你的仓库地址）
FEED_URL=https://raw.githubusercontent.com/YOUR_USERNAME/xTrendingRSS/main/trending.xml

# ---------------------------
# 可选配置 - AI 增强功能
# ---------------------------
# 使用 OpenCode 的 GLM-4 免费模型为每条 trending 生成中文摘要
# 
# 获取 API Key:
#   1. 访问 https://open.bigmodel.cn/
#   2. 注册并登录（支持微信/手机号）
#   3. 控制台 → API 密钥 → 创建新密钥
#   4. 复制密钥并粘贴到下方
#
# 注意: 
#   - 不配置此项仍可正常运行，只是不会生成 AI 摘要
#   - 智谱提供免费额度，日常使用足够
#   - 等效于 OpenCode 的 opencode/glm-4.7-free 模型

ZHIPUAI_API_KEY=your_zhipuai_api_key_here
